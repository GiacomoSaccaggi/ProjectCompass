# ProjectCompass Configuration
# Copy this file to .env and edit values

# Flask secret key (use a random string in production)
SECRET_KEY=change-me-to-a-random-string

# Admin credentials
# Generate hash: uv run python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Database (default: SQLite in project root)
# DATABASE_URL=sqlite:///projectcompass.db

# Server
PORT=5000
FLASK_DEBUG=False

# GitLab integration
USE_GITLAB_REPO=False

# Mithril LLM backend (optional — app works without it)
MITHRIL_HOST=http://localhost:16180

# Mithril API keys (for cloud providers via Mithril)
# MITHRIL_KEY_GEMINI=AIza...
# MITHRIL_KEY_OPENAI=sk-...
# MITHRIL_KEY_ANTHROPIC=sk-ant-...
# MITHRIL_KEY_GROQ=gsk_...

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=*

# RAG Configuration
# Embedding backend: 'local' (E5 model, zero cost, default) or 'mithril' (cloud via Mithril)
RAG_EMBED_BACKEND=local
# Cloud embedding model (only used when RAG_EMBED_BACKEND=mithril)
MITHRIL_EMBED_MODEL=gemini-embedding-exp-03-07
# Reranking model (always uses Mithril cloud)
MITHRIL_RERANK_MODEL=gemini-2.5-flash
